{
  "name": "okwx",
  "version": "0.1.0",
  "description": "Oklahoma weather desktop app with forecasts, alerts and (pending permission) ODOT traffic cameras.",
  "main": "main.js",
  "author": "Bryson",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.okwx.app",
    "productName": "okwx",
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "okwx-portable-${version}.exe"
    }
  }
}
